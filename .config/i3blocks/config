# Global properties
separator=false
separator_block_width=50

[memory]
command=./scripts/memory.sh
interval=10
signal=1

[battery]
command=echo $(cat /sys/class/power_supply/BAT0/capacity)%
interval=100

[volume]
label=VOL 
command=./scripts/volume.sh
interval=once
signal=10
#STEP=5%
#MIXER=[determined automatically]
#SCONTROL=[determined automatically]
#NATURAL_MAPPING=0

[time]
command=date '+%Y-%m-%d %H:%M:%S'
interval=5

