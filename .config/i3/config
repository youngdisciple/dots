set $mod Mod4
font pango:System San Francisco Display 12 

exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -i ~/Pictures/bg01-lock.png --nofork
exec --no-startup-id nm-applet

floating_modifier $mod

bindsym $mod+Return exec kitty
bindsym $mod+Shift+q kill

bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+h focus left

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+h move left

bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

set $ws1 "1:	Docs"
set $ws2 "2:	Code"
set $ws3 "3:	Ref"
set $ws4 "4:	Social"
set $ws5 "5: 	Random"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# ASSIGNS (PERSONAL)

# Workspace 1
assign [class="firefox"] $ws1

# Workspace 2
assign [class="kitty"] $ws2

# Workspace 4
assign [class="discord"] $ws4

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3 exit"

bindsym $mod+r mode "resize"
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym j resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bar {
    position bottom
        status_command i3blocks
        tray_output none
        colors {
            background #282A364D
                statusline #F8F8F2
                separator  #44475A

                focused_workspace  #44475A #44475A #F8F8F2
                active_workspace   #282A36 #44475A #F8F8F2
                inactive_workspace #282A36 #282A36 #BFBFBF
                urgent_workspace   #FF5555 #FF5555 #F8F8F2
                binding_mode       #FF5555 #FF5555 #F8F8F2
        }
}

# Start on startup
exec --no-startup-id picom --config ~/.config/picom/picom.conf
exec_always --no-startup-id feh --bg-scale ~/Pictures/bg03.jpg
exec_always --no-startup-id xinput set-prop "SYNA8018:00 06CB:CE67 Touchpad" "libinput Natural Scrolling Enabled" 1
exec_always --no-startup-id xinput set-prop "SYNA8018:00 06CB:CE67 Touchpad" "libinput Scrolling Pixel Distance" 40
exec_always --no-startup-id xinput set-prop "SYNA8018:00 06CB:CE67 Touchpad" "libinput Tapping Enabled" 1
exec_always --no-startup-id setxkbmap -layout us,ara -variant ,mac -option ctrl:swap_lalt_lctl,grp:ctrl_space_toggle caps:swapescape
exec_always --no-startup-id xset r rate 300 30

# Multimedia keys

# Pulse Audio controls
bindsym XF86AudioMute exec --no-startup-id sh -c "pactl set-sink-mute 0 toggle && pkill -SIGRTMIN+10 i3blocks"
bindsym XF86AudioLowerVolume exec --no-startup-id sh -c "pactl set-sink-volume 0 -5% && pkill -SIGRTMIN+10 i3blocks"
bindsym XF86AudioRaiseVolume exec --no-startup-id sh -c "pactl set-sink-volume 0 +5% && pkill -SIGRTMIN+10 i3blocks"

# Screen brightness controls
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set 5%+

# Display to main screen
bindsym $mod+Shift+d exec "xrandr --output eDP-1 --off --output HDMI-1 --auto"

# rofi
bindsym $mod+d exec "rofi -show drun"

# passmenu
bindsym $mod+p exec "passmenu"

# flameshot
bindsym ctrl+Shift+s exec "flameshot gui"

# mpv-clip
bindsym $mod+Shift+i exec "/home/yd/.local/bin/mpv-clip"

# gaps
gaps inner 10px

# window decoration
for_window [class=".*"] border pixel 2
#border #bg     #text   
client.focused          #88c0d0 #88c0d0 #2e3440 #88c0d0 #8895D0
client.focused_inactive #4c566a #3b4252 #d8dee9 #3b4252 #3b4252
client.unfocused        #4c566a #3b4252 #d8dee9 #3b4252 #3b4252
client.urgent           #bf616a #bf616a #eceff4 #bf616a #bf616a
client.background       #2e3440

# scratchpads
exec_always --no-startup-id pgrep -f '^kitty --class scratch_term,scratch_term' || kitty --class scratch_term,scratch_term

for_window [class="scratch_term"]    floating enable, resize set 60 ppt 70 ppt, move position 384 162, move scratchpad
for_window [class="mpv"]             floating enable, resize set 640 360, move position 1270 10, move scratchpad

bindsym $mod+u [class="scratch_term"]    scratchpad show
bindsym $mod+i [class="mpv"]         scratchpad show

# Sound System
exec pactl set-default-sink bluez_output.07_11_34_00_B9_D6.1
exec pactl set-default-source alsa_input.usb-Blue_Microphones_Yeti_Stereo_Microphone-00.analog-stereo
