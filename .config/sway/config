########## 
# Visual #
##########

# gaps
gaps inner 5
gaps outer 0

# borders
default_border pixel 2
smart_borders on

#mouse focus
focus_follows_mouse no

#gtk
set $gnome-schema org.gnome.desktop.interface
exec_always {
        gsettings set $gnome-schema gtk-theme       'Catppuccin-Dark'
        gsettings set $gnome-schema icon-theme      'Papirus-Dark'
        gsettings set $gnome-schema font-name       'JetBrainsMono NFM 12'
}
# I can't use gsettings for this for some reason
seat seat0 xcursor_theme catppuccin-macchiato-blue-cursors 20

set $cl_high #4186a9
set $cl_indi #4186a9
set $cl_back #10111c
set $cl_fore #ffffff
set $cl_urge #ee2e24

#class                  border      background  text        indicator   child_border
client.focused          $cl_high    $cl_high    $cl_fore    $cl_indi    $cl_high
client.focused_inactive $cl_back    $cl_back    $cl_fore    $cl_back    $cl_back
client.unfocused        $cl_back    $cl_back    $cl_fore    $cl_back    $cl_back
client.urgent           $cl_urge    $cl_urge    $cl_fore    $cl_urge    $cl_urge

#############
# Variables #
#############

set $mod Mod4

set $left h
set $down j
set $up k
set $right l

# Workspaces:
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

# Terminal
set $term kitty

# App Launcher
set $menu rofi

# float modifier (drag and resize with mod + left and right click respectively)
floating_modifier $mod normal

########################
# Output configuration #
########################

# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
output * bg /home/yd/Pictures/bg03.jpg fill

# Vertical setup for external monitors
output HDMI-A-1 resolution 1920x1080 position 1920,0 transform 270

###################### 
# Idle configuration #
###################### 

exec swayidle -w \
         timeout 300 'swaylock -f -c 000000' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         before-sleep 'swaylock -f -c 000000'

#######################
# Input configuration #
####################### 

         input type:touchpad {
             dwt enabled
                 tap enabled
                 natural_scroll enabled
                 middle_emulation enabled
                 pointer_accel 0
                 scroll_factor 0.3
         }

input type:pointer {
    pointer_accel -0.5
        scroll_factor 0.3
}

input type:keyboard {
    xkb_layout "us, ara(mac)"
        xkb_options "ctrl:swap_lalt_lctl, caps:swapescape, grp:shifts_toggle"
        repeat_delay 200
}

################
# Key bindings #
################

# Start a terminal
bindsym $mod+Return             exec $term

# Kill focused window
bindsym $mod+Shift+q            kill

# Start launcher
bindsym $mod+d                  exec "$menu -show drun"

# Toggle eDP-1
bindsym $mod+F1                 exec swaymsg output eDP-1 toggle

# Reload the configuration file
bindsym $mod+Shift+c            reload

# Exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+escape       exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# Move your focus around
bindsym $mod+$left              focus left
bindsym $mod+$down              focus down
bindsym $mod+$up                focus up
bindsym $mod+$right             focus right

# Move the focused window with the same, but add Shift
bindsym $mod+Shift+$left        move left
bindsym $mod+Shift+$down        move down
bindsym $mod+Shift+$up          move up
bindsym $mod+Shift+$right       move right


# Switch to workspace
bindsym $mod+1                  workspace number $ws1
bindsym $mod+2                  workspace number $ws2
bindsym $mod+3                  workspace number $ws3
bindsym $mod+4                  workspace number $ws4
bindsym $mod+5                  workspace number $ws5

# Move focused container to workspace
bindsym $mod+Shift+1            move container to workspace number $ws1
bindsym $mod+Shift+2            move container to workspace number $ws2
bindsym $mod+Shift+3            move container to workspace number $ws3
bindsym $mod+Shift+4            move container to workspace number $ws4
bindsym $mod+Shift+5            move container to workspace number $ws5

# Split focus
bindsym $mod+b splith
bindsym $mod+v splitv

# Switch the current container between different layout styles
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Make the current focus fullscreen
bindsym $mod+f fullscreen

# Swap focus between the tiling area and the floating area
bindsym $mod+space focus mode_toggle

# Toggle the current focus between tiling and floating mode
bindsym $mod+Shift+space floating toggle

# Move focus to the parent container
bindsym $mod+a focus parent

# Resizing:
bindsym $mod+r mode "resize"

mode "resize" {
    bindsym     $left   resize shrink width 10px
        bindsym $down   resize grow height 10px
        bindsym $up     resize shrink height 10px
        bindsym $right  resize grow width 10px

        bindsym Return  mode "default"
        bindsym Escape  mode "default"
}

# Adjust volume via PulseAudio
bindsym --locked XF86AudioMute          exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume   exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume   exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
bindsym --locked XF86AudioMicMute       exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

# Control media via playerctl
bindsym --locked XF86AudioPlay          exec playerctl play-pause
bindsym --locked XF86AudioPause         exec playerctl play-pause
bindsym --locked XF86AudioPrev          exec playerctl previous
bindsym --locked XF86AudioNext          exec playerctl next
bindsym --locked XF86AudioStop          exec playerctl stop

# Adjust brightness via brightnessctl
bindsym --locked XF86MonBrightnessDown  exec brightnessctl set 10%-
bindsym --locked XF86MonBrightnessUp    exec brightnessctl set 10%+

# Passmenu
bindsym $mod+Shift+p exec passmenu

# Terminal Scratchpad
bindsym $mod+u exec --no-startup-id /home/yd/.local/bin/sway-scratchpad -t -d 60%x60% -- kitty --app-id term-scratchpad

# Screenshots
bindsym $mod+s          exec grim -g "$(slurp)" - | swappy -f - 
bindsym $mod+Shift+s    exec grim -g "$(slurp)" - | wl-copy

################
# Layout Stuff #
################

# Assign applications to workspaces
assign [app_id="firefox"]                       workspace $ws1
assign [app_id="kitty"]                         workspace $ws2
assign [app_id="robloxstudiobeta.exe"]          workspace $ws3
assign [app_id="webcord"]                       workspace $ws4
assign [app_id="org.vinegarhq.Sober"]           workspace $ws4

# pavu
set $pavu          [app_id="org.pulseaudio.pavucontrol"]
for_window $pavu {
    floating enable                       
        resize set width 50 ppt height 50 ppt 
        move position center                  
}

# term-scratchpad
for_window [app_id="term-scratchpad"] {
    border pixel 3
}

# swappy
for_window [app_id="swappy"] {
    border pixel 3
}

# Rbx Studio
for_window [app_id="robloxstudiobeta.exe"] {
    floating enable,
             resize set 99 ppt 96 ppt,
             move position 10 10
}
##############
# Status Bar #
##############

bar {
    swaybar_command waybar
}

#########
# Execs #
#########

# polkit
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

include /etc/sway/config.d/*

